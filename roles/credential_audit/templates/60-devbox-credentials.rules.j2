## Managed by Ansible (secure-dev-vm)
## Reads and writes of credential files. Key: devbox_creds
-w /home/{{ dev_user }}/.ssh/ -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.aws/ -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.config/gh/ -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.config/gcloud/ -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.docker/ -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.npmrc -p rwa -k devbox_creds
-w /home/{{ dev_user }}/.git-credentials -p rwa -k devbox_creds

## Changes to files that make code run at login or on shell start
## (a common persistence trick). Key: devbox_persist
-w /home/{{ dev_user }}/.bashrc -p wa -k devbox_persist
-w /home/{{ dev_user }}/.profile -p wa -k devbox_persist
-w /home/{{ dev_user }}/.config/systemd/ -p wa -k devbox_persist
-w /etc/cron.d/ -p wa -k devbox_persist
