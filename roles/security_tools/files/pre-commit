#!/usr/bin/env bash
# Managed by Ansible (secure-dev-vm).
# Blocks a commit when the staged changes contain a secret.
# Scans the staged version of each file, so what's checked is exactly
# what would be committed. Bypass once, after you've checked it's a
# false positive: git commit --no-verify
set -euo pipefail

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

count=0
while IFS= read -r -d '' path; do
  mkdir -p "$tmp/$(dirname "$path")"
  git show ":$path" > "$tmp/$path" 2>/dev/null || continue
  count=$((count + 1))
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

[ "$count" -eq 0 ] && exit 0

if ! trufflehog filesystem "$tmp" --no-update --no-verification --fail --no-color 2>/dev/null \
    | sed "s#$tmp/##g"; then
  echo
  echo "pre-commit: possible secret in the staged changes (see above). Commit blocked."
  echo "Remove it, rotate it if it was real, then commit again."
  exit 1
fi
